<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include non-sensitive preferences and offline database -->
    <include domain="file" path="datastore/" />
    <include domain="database" path="hustlehub.db" />

    <!-- Exclude hardware-encrypted preferences that cannot be decrypted on a new device -->
    <exclude domain="sharedpref" path="hustlehub_e2ee_prefs.xml" />
    <exclude domain="root" path="coil/" />
</full-backup-content>