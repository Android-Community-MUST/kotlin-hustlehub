    <!-- Getting Started FAQs -->
    <string name="faq_qs_create_service">How do I create a service?</string>
    <string name="faq_ans_create_service">Go to Profile → + Add Service. Fill in the service title, category, description, and price range, then tap Publish.</string>
    <string name="faq_qs_student_verify">How do I get verified as a student?</string>
    <string name="faq_ans_student_verify">Go to Settings → Verify Student ID. Only @students.must.ac.ke emails are accepted.</string>

    <!-- Services FAQs -->
    <string name="faq_qs_manage_service">How do I edit or delete a service?</string>
    <string name="faq_ans_manage_service">Go to Profile → My Services, tap the service you want to manage, then choose Edit or Delete from the options.</string>
    <string name="faq_qs_service_removed">Why was my service removed?</string>
    <string name="faq_ans_service_removed">Services that violate our community guidelines are removed by moderators. Check your registered email for details and contact support if you believe this was in error.</string>

    <!-- Messaging FAQs -->
    <string name="faq_qs_share_phone">Can I share my phone number in chat?</string>
    <string name="faq_ans_share_phone">We recommend keeping contact info private until you are confident about a booking. Sharing personal details prematurely increases the risk of fraud.</string>
    <string name="faq_qs_cannot_message">"Why can't I message a provider?"</string>
    <string name="faq_ans_cannot_message">The provider may have restricted messaging to verified users only. Make sure your student email is verified in Settings.</string>

    <!-- Payments FAQs -->
    <string name="faq_qs_mpesa_pay">How do I pay via M-Pesa?</string>
    <string name="faq_ans_mpesa_pay">Tap "Upgrade to Pro" or "Boost Service", enter your Safaricom number in the format 07XX..., then confirm the STK push prompt on your phone.</string>
    <string name="faq_qs_payment_unconfirmed">"What if my payment isn't confirmed?"</string>
    <string name="faq_ans_payment_unconfirmed">Wait a few minutes and check your M-Pesa messages for a confirmation or failure alert. If the issue persists, tap "Contact Support" below.</string>

    <!-- Safety FAQs -->
    <string name="faq_qs_report_user">How do I report a user?</string>
    <string name="faq_ans_report_user">Tap the three-dot menu on their profile, in chat, or on a service listing, then select Report. Our team reviews all reports within 24 hours.</string>
    <string name="faq_qs_block_user">What happens after I block someone?</string>
    <string name="faq_ans_block_user">They will not appear in your feed, map, or chat. You can manage and unblock users any time in Settings → Blocked Users.</string>
