<?xml version="1.0" encoding="utf-8"?>
<!-- Debug Network Security Config: Allows cleartext HTTP to local backend IPs (10.x.x.x, 192.168.x.x, 10.0.2.2) during development -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
