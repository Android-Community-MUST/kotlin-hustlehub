# API Keys & Release Signing Configuration
# Copy this file to keys.properties and add your actual API keys & keystore details
# NEVER commit keys.properties or keystore files to version control!

# Google Maps API Key
# Get from: https://console.cloud.google.com
# Enable: Maps SDK for Android
MAPS_API_KEY=your_google_maps_api_key_here

# Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Backend REST & WebSocket URLs
BASE_URL=http://10.0.2.2:8080/api/v1/
WS_BASE_URL=ws://10.0.2.2:8080/ws

# Release Signing Keystore Parameters (Issue #99)
# KEYSTORE_FILE=release.keystore
# KEYSTORE_PASSWORD=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
